<IfModule mod_rewrite.c>
  RewriteEngine On
  # Ensure the base path matches the subfolder name
  RewriteBase /homepulse/

  # If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If an HTML file exists for the request, rewrite to it
  # (Useful if trailingSlash was false, but harmless if true)
  RewriteCond %{DOCUMENT_ROOT}/homepulse/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Next.js generates a custom 404.html page on static export
  ErrorDocument 404 /homepulse/404.html
</IfModule>
